#
# Establish project-wide standard of LF line endings.
#
# `text=auto` detects text vs. binary by content, so the rules below cover
# only two cases: where that detection must not be trusted, and where the
# line ending must not be LF.
#

* text=auto eol=lf

#
# Interactive fiction formats.
#
# Git would almost certainly detect these as binary on its own, but they
# are this project's core data. Declaring them explicitly means a story
# file or test fixture can never be corrupted by normalization.
#

# Z-Machine and Glulx story files
*.z[1-8]   binary
*.[zbg]lb  binary
*.*blorb   binary
*.ulx      binary

# Saved games (Quetzal) and other Infocom-era data files
*.qzl      binary
*.sav      binary
*.dat      binary

# The Å-machine's story files
*.aastory  binary

#
# Files whose line endings must not be LF.
#

*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.sln      text eol=crlf

#
# Diff drivers, so hunk headers name the enclosing type or member.
#

*.cs       text diff=csharp
*.csx      text diff=csharp
*.md       text diff=markdown

#
# Some contents must survive byte-for-byte.
#

*.patch    -text

#
# Exclude from `git archive`, which is what produces GitHub's "Download ZIP"
# and release source tarballs. Someone taking the project that way is not
# cloning it, so repository plumbing is noise to them.
#

.editorconfig  export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore
.githooks/     export-ignore
.github/       export-ignore
