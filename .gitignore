#
# Build output
#

[Bb]in/
[Oo]bj/

# The .NET artifacts output layout, if UseArtifactsOutput is enabled.
/artifacts/

#
# Test and diagnostic output
#

TestResults/
*.binlog

#
# Editor helpers
#
# Ignore the contents of .vscode rather than the directory itself.
# Git does not descend into an ignored directory, so `.vscode/`
# would make the negations below unreachable.
#

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Visual Studio, for anyone who does not take the VS Code suggestion.
.vs/
*.user

#
# Operating system metadata
#

**/.directory
**/.DS_Store
**/desktop.ini
**/Thumbs.db
