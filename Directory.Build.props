<Project>

  <!--
    Defaults shared by every project in the repository. Individual projects
    override whatever they need; nothing here is meant to be final.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Reproducibility and NativeAOT.

    InvariantGlobalization drops the ICU dependency. That shrinks the native
    binary, but the more important effect is removing a class of
    machine-to-machine variation: no culture-dependent casing, comparison,
    or number formatting. The Z-Machine and Glulx specs define their own
    text handling, so nothing in the interpreter should vary by locale, and
    a recorded session must replay identically on every platform.
  -->

  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Enable the trim, single-file, and AOT analyzers so AOT-hostile code is
    reported while building the library it lives in, rather than discovered
    much later at `dotnet publish -p:PublishAot=true`.

    Test projects are excluded because test frameworks use reflection by
    design and would report warnings that cannot be acted on.

    PublishAot itself belongs on the executable projects, not here.
  -->

  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The interpreter libraries are built optimized in every configuration.

    The test suite replays whole games through the interpreters, and an
    unoptimized Glulx interpreter runs an Inform 7 game about nine times
    slower than an optimized one, which turned a thirty second test run
    into several minutes. The programs and the tests stay unoptimized, so
    debugging a frontend or a test body is unchanged. To step through the
    interpreters themselves with every local in view, build once with
    `dotnet build -p:Optimize=false`; a property given on the command line
    overrides this one.
  -->

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Rezrov.Core' Or '$(MSBuildProjectName)' == 'Rezrov.ZMachine' Or '$(MSBuildProjectName)' == 'Rezrov.Glulx'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    Make .editorconfig mean something at the command line and in CI, not
    only inside an editor.
  -->

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!--
    Warnings stay advisory while working locally and become fatal in CI, so
    exploratory work stays comfortable without letting anything reach main.
    CI opts in with `-p:ContinuousIntegrationBuild=true`, which also
    normalizes embedded source paths for deterministic output.
  -->

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The version every project and binary carries, and the one a release
    is cut at. The release workflow refuses a tag that disagrees with it,
    so a release starts by changing this line.
  -->

  <PropertyGroup>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Jeff Nyman</Authors>
    <Product>Rezrov</Product>
    <Copyright>Copyright (c) 2026 Jeff Nyman</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
