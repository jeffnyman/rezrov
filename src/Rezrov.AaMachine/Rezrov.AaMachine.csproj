<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The third machine. Dialog, a language for interactive fiction whose
    rules read like logic rather than like code, compiles either to the
    Z-Machine or to a machine of its own, the Aa-machine, which is built
    around the way Dialog thinks: unification, choice points, and
    backtracking. This project reads and runs that machine.

    So far it reads the container, the header, and the language: the
    character set a game is written in, the tree its text is packed
    against, and the dictionary its commonest words come out of. That
    is enough to make a story speak. It also reads the bytecode, which
    is a long way from running it, but the whole of the CODE chunk
    decodes and everything it points at is where it says.
  -->

  <PropertyGroup>
    <RootNamespace>Rezrov.AaMachine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rezrov.Core\Rezrov.Core.csproj" />
  </ItemGroup>

</Project>
