<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AssemblyName is lowercase so the produced binary is `rezrov`, which is
    what someone types, rather than `Rezrov.Cli`.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rezrov</AssemblyName>

    <!--
      A publish is a NativeAOT publish: one native executable with no
      runtime beside it. Building and testing are unaffected; only
      `dotnet publish -r <rid>` takes the long road.
    -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rezrov.Core\Rezrov.Core.csproj" />
    <ProjectReference Include="..\Rezrov.ZMachine\Rezrov.ZMachine.csproj" />
  </ItemGroup>

</Project>
