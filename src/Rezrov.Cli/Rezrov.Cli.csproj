<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AssemblyName is lowercase so the produced binary is `rezrov`, which is
    what someone types, rather than `Rezrov.Cli`.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rezrov</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rezrov.Core\Rezrov.Core.csproj" />
    <ProjectReference Include="..\Rezrov.ZMachine\Rezrov.ZMachine.csproj" />
  </ItemGroup>

</Project>
