#!/bin/sh
#
# Reject commit messages that do not follow Conventional Commits.
#
# The shape is `type(optional scope)!: description`, where the optional `!`
# marks a breaking change. Plain POSIX shell with no dependencies, so it
# behaves the same in Git Bash on Windows as it does on macOS and Linux.
#
# Activate it with `git config core.hooksPath .githooks` from the repository
# root. Bypass it for a single commit with `git commit --no-verify` if you
# genuinely need to.

message_file="$1"

# The subject is the first line that is neither blank nor a comment, since
# Git writes its own help text into this file as comments.
subject=$(grep -v '^#' "$message_file" | grep -v '^[[:space:]]*$' | head -n 1)

# An empty message is Git's problem, not ours; it aborts on its own.
if [ -z "$subject" ]; then
    exit 0
fi

# Git writes these itself during merges, reverts, and autosquash rebases,
# so they are not ours to police.
case "$subject" in
    'Merge '*) exit 0 ;;
    'Revert "'*) exit 0 ;;
    'fixup! '*|'squash! '*|'amend! '*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
pattern="^(${types})(\([a-z0-9._-]+\))?!?: .+"

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    printf '\n'
    printf 'The commit message does not follow Conventional Commits.\n\n'
    printf '  subject: %s\n\n' "$subject"
    printf 'Expected `type(optional scope): description`, using one of:\n\n'
    printf '  build  chore  ci  docs  feat  fix  perf  refactor  revert  style  test\n\n'
    printf 'For example:\n\n'
    printf '  feat: decode variable form opcodes\n'
    printf '  fix(zmachine): correct branch offset sign extension\n'
    printf '  docs: explain the Glk and Glulx split\n'
    printf '  feat(glulx)!: replace the accelerated function table\n\n'
    exit 1
fi

limit=72
length=$(printf '%s' "$subject" | awk '{ print length }')

if [ "$length" -gt "$limit" ]; then
    printf '\n'
    printf 'The commit subject is %s characters, over the %s character limit.\n\n' "$length" "$limit"
    printf '  subject: %s\n\n' "$subject"
    printf 'Move the detail into the commit body, leaving a blank line after the subject.\n\n'
    exit 1
fi

exit 0
