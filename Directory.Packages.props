<Project>

  <!--
    Central Package Management. Projects reference a package by name only:

      <PackageReference Include="System.CommandLine" />

    and the version is resolved from this file. One version of a dependency
    across Rezrov.Core, the frontends, and the tests, changed in one place.

    Versions verified against nuget.org on 2026-09-08.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Tests.

    xUnit v3 runs on Microsoft Testing Platform, where a test project is its
    own executable. That removes the need for Microsoft.NET.Test.Sdk and
    xunit.runner.visualstudio, which the older VSTest arrangement required,
    and it keeps the test project compatible with NativeAOT.

    Code coverage is not wired up yet. When it is, it comes from
    Microsoft.Testing.Extensions.CodeCoverage rather than coverlet.
  -->

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!--
    The terminal frontend.

    Terminal.Gui 2.4.17 is the current stable release as of 2026-09-10 and
    publishes cleanly under NativeAOT. Onigwrap is not used directly: it
    is the native regex library behind Terminal.Gui's syntax highlighter,
    and Rezrov.Tui references it only to exclude its native asset from
    the published output. Its version is pinned here because central
    package management requires a version for every reference.
  -->

  <ItemGroup>
    <PackageVersion Include="Terminal.Gui" Version="2.5.0" />
    <PackageVersion Include="Onigwrap" Version="1.0.11" />
  </ItemGroup>

  <!--
    The graphical frontend.

    Avalonia 12.1.2 is the current stable release as of 2026-09-16. It
    compiles and publishes under NativeAOT with no trim warnings, but it
    cannot be a single file: Skia and HarfBuzz are native libraries that
    have to sit beside the executable, and SkiaSharp ships no static
    build. The published program is therefore a folder, unlike the
    command line and terminal programs, which stay single files.

    Avalonia.Angle.Windows.Natives is not used directly. It is the ANGLE
    build behind Avalonia's GPU path on Windows, and Rezrov.Gui
    references it only to exclude its native asset, which takes five
    megabytes out of the published folder. Its version is pinned here
    because central package management requires a version for every
    reference.
  -->

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" />
  </ItemGroup>

</Project>
