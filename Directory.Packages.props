<Project>

  <!--
    Central Package Management. Projects reference a package by name only:

      <PackageReference Include="System.CommandLine" />

    and the version is resolved from this file. One version of a dependency
    across Rezrov.Core, the frontends, and the tests, changed in one place.

    Versions verified against nuget.org on 2026-09-08.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Tests.

    xUnit v3 runs on Microsoft Testing Platform, where a test project is its
    own executable. That removes the need for Microsoft.NET.Test.Sdk and
    xunit.runner.visualstudio, which the older VSTest arrangement required,
    and it keeps the test project compatible with NativeAOT.

    Code coverage is not wired up yet. When it is, it comes from
    Microsoft.Testing.Extensions.CodeCoverage rather than coverlet.
  -->

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <!--
    Deliberately not declared yet: Avalonia (GUI) and Terminal.Gui (TUI).

    Both are pinned only when a project actually references them. Declaring
    a version months before first use just guarantees it is stale on
    arrival. For reference, the current releases as of the date above are
    Avalonia 12.1.2 and Terminal.Gui 2.4.17.
  -->

</Project>
