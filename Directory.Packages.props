<Project>

  <!--
    Central Package Management. Projects reference a package by name only:

      <PackageReference Include="System.CommandLine" />

    and the version is resolved from this file. One version of a dependency
    across Rezrov.Core, the frontends, and the tests, changed in one place.

    Versions verified against nuget.org on 2026-09-08.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Tests.

    xUnit v3 runs on Microsoft Testing Platform, where a test project is its
    own executable. That removes the need for Microsoft.NET.Test.Sdk and
    xunit.runner.visualstudio, which the older VSTest arrangement required,
    and it keeps the test project compatible with NativeAOT.

    Code coverage is not wired up yet. When it is, it comes from
    Microsoft.Testing.Extensions.CodeCoverage rather than coverlet.
  -->

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <!--
    The terminal frontend.

    Terminal.Gui 2.4.17 is the current stable release as of 2026-09-10 and
    publishes cleanly under NativeAOT. Onigwrap is not used directly: it
    is the native regex library behind Terminal.Gui's syntax highlighter,
    and Rezrov.Tui references it only to exclude its native asset from
    the published output. Its version is pinned here because central
    package management requires a version for every reference.
  -->

  <ItemGroup>
    <PackageVersion Include="Terminal.Gui" Version="2.4.17" />
    <PackageVersion Include="Onigwrap" Version="1.0.11" />
  </ItemGroup>

  <!--
    Deliberately not declared yet: Avalonia (GUI). It is pinned only when
    a project actually references it, since declaring a version months
    before first use just guarantees it is stale on arrival. For reference,
    the current release as of the date above is Avalonia 12.1.2.
  -->

</Project>
